{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/build",
      "!**/test-results",
      "!**/.playwright-mcp",
      "!**/.claude",
      "!**/.agents",
      "!**/resume_render_check",
      "!**/resume_review_current"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noUnknownAtRules": {
          "level": "off"
        },
        "noArrayIndexKey": {
          "level": "warn"
        }
      },
      "correctness": {
        "useUniqueElementIds": {
          "level": "off"
        }
      },
      "a11y": {
        "noSvgWithoutTitle": {
          "level": "warn"
        }
      }
    }
  },
  "css": {
    "parser": {
      "cssModules": false,
      "tailwindDirectives": true
    },
    "linter": {
      "enabled": false
    },
    "formatter": {
      "enabled": false
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    },
    "assist": {
      "enabled": true
    }
  }
}
